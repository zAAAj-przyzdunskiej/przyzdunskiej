# Wszystkie wartości podajemy BEZ końcowego średnika — jest brany dosłownie jako część wartości.

# -----------------------------------------------------------------------------
# PostgreSQL (docker-compose.yml.example uruchamia lokalną bazę)
# -----------------------------------------------------------------------------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=6500
POSTGRES_USER=admin
POSTGRES_PASSWORD=password123
POSTGRES_DB=sveltekit_jwt_app

# -----------------------------------------------------------------------------
# pgAdmin4 Credentials for Docker Compose
# -----------------------------------------------------------------------------
# PGADMIN_DEFAULT_EMAIL=admin@admin.com
# PGADMIN_DEFAULT_PASSWORD=password123
# PGADMIN_LISTEN_PORT=80

# -----------------------------------------------------------------------------
# Sesja / JWT
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=[losowy sekret]
JWT_EXPIRES_IN=60
# Ważność 4-cyfrowego PIN-u wysyłanego SMS-em, w minutach
PINCODE_EXPIRED_IN=30

# -----------------------------------------------------------------------------
# MyDr EDM — wspólny host obu instancji
# Produkcja: https://edm.mydr.pl/secure/ext_api
# Testy:     https://api.edm.mydr.pl/secure/ext_api
# -----------------------------------------------------------------------------
MYDR_URL=[MyDr API URL]

# MyDr1 — POZ (lekarz rodzinny), departament "_"
MYDR_USER=[username]
MYDR_PASSWORD=[password]
MYDR_CLIENT_ID=[clientId]
MYDR_CLIENT_SECRET=[clientSecret]
# Sekret base32 z kodu QR 2FA (parametr `secret=` z otpauth://...).
# MyDr udostępnia go TYLKO dopóki urządzenie OTP nie jest potwierdzone — po potwierdzeniu
# nie da się go odzyskać; trzeba wtedy usunąć i dodać urządzenie OTP na nowo w panelu web.
MYDR_TOTP_SECRET=[sekret base32]

# MyDr2 — ginekologia, departament "51934"
MYDR2_USER=[username]
MYDR2_PASSWORD=[password]
MYDR2_CLIENT_ID=[clientId]
MYDR2_CLIENT_SECRET=[clientSecret]
MYDR2_TOTP_SECRET=[sekret base32]

# Domyślne typy wizyt (id z MyDr): pierwszy dla POZ, drugi dla ginekologii
DEFAULT_VISIT_TYPE=[id typu wizyty]
DEFAULT_VISIT_TYPE2=[id typu wizyty]

# -----------------------------------------------------------------------------
# Bramka SMS
# -----------------------------------------------------------------------------
GSM_URL=[URL bramki]
GSM_LOGIN=[login]
GSM_PASS=[password]

# -----------------------------------------------------------------------------
# Komunikaty dla użytkownika — kod używa ~25 zmiennych PUBLIC_*,
# pełną listę widać w src/ (grep PUBLIC_). Poniżej te najczęściej zmieniane.
# -----------------------------------------------------------------------------
PUBLIC_SERVER_ERROR="Wystąpił błąd serwera. Prosimy spróbować później."
PUBLIC_FAIL_MYDR="Nie udało się utworzyć konta w systemie placówki."
PUBLIC_NO_DECLARATION="Nie znaleziono deklaracji wyboru w naszej placówce."
PUBLIC_VISIT_APPOINTED="Wizyta została zaplanowana."
